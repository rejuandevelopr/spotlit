# Copy to .env.local and fill in. Never commit real keys.

# ---- Mock mode (no keys needed). Set both to 1 to run fully offline. ----
SPOTLIT_MOCK=
NEXT_PUBLIC_SPOTLIT_MOCK=

# ---- Qloo (hackathon key) ----
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# ---- Gemini (Google AI Studio key) ----
GOOGLE_GENERATIVE_AI_API_KEY=
# Fast model for personas, venue and proxy replies. Smart model for concierge, analyst, strategist.
MODEL_FAST=gemini-3.1-flash-lite
MODEL_SMART=gemini-3-flash-preview
# Max parallel LLM calls (lower this on the free tier)
LLM_CONCURRENCY=4
# LLM use inside arena runs: all, concierge (personas and venue replies use deterministic
# templates, the concierge still rates with Gemini) or off. "concierge" makes a 60 persona
# run about 6x cheaper on the free tier. Scores never depend on the LLM for taste.
ARENA_LLM=all

# ---- Firebase web app (public) ----
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- Firebase Admin (server only, from the service account JSON) ----
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private_key value in double quotes and keep the \n escapes, like "-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional random string (openssl rand -hex 32). Lets an outside cron call POST /api/arena/<runId>/tick
# with the header x-spotlit-secret to resume a stalled run.
INTERNAL_TASK_SECRET=
DEMO_CITY=New York
DEMO_VENUE_SLUG=halftone-house
# Optional: the Google account with this email manages the demo venue after signing in
DEMO_OWNER_EMAIL=
# 1 = serve cached Qloo responses only (judging safety net)
DEMO_MODE=
ARENA_MAX_PERSONAS_PUBLIC=24
# Arena runs (baseline and what-if) one account may start per 24 hours. DEMO_OWNER_EMAIL is not limited.
ARENA_RUNS_PER_DAY=4
ARENA_MAX_PERSONAS_DEMO=60
SESSION_COOKIE_DAYS=14
# 1 = the concierge calls venue agents in process instead of over HTTP (local speed only)
A2A_INPROCESS=
